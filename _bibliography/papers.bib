@inproceedings{gaus2026beyond,
  abbr            = {NeurIPS AI4GOOD},
  title           = {Beyond Drift Detection: Deployment Monitoring for Selective Prediction},
  author          = {Gaus, Johannes A. and Nalivayko, Yaroslava and Wochner, Isabell and Ilg, Winfried and Haeufle, Daniel},
  booktitle       = {NeurIPS 2026 Workshop on Trustworthy AI for Good},
  year            = {2026},
  address         = {Paris, France},
  html            = {https://jo997.github.io/papers/drift-monitoring/},
  website         = {https://openreview.net/forum?id=K7XYZERwq7},
  bibtex_show     = {true},
  selected        = {true},
  additional_info = {Reframes post-deployment monitoring as an authorization decision rather than a generic drift alarm. The controller checks risk, coverage, and whether deferrals still target useful interventions, then recommends continuing, retuning, watching, escalating, or revoking autonomy. Across activity-recognition experiments, this guarded approach avoids infeasible authorizations that arise from risk-only retuning. Poster at the NeurIPS 2026 Trustworthy AI for Good workshop in Paris.}
}

@inproceedings{gaus2026intervention,
  abbr            = {NeurIPS AI4GOOD},
  title           = {When Failure Ranking Misses Intervention Value: A Calibration-Time Audit for Selective Prediction},
  author          = {Gaus, Johannes A. and Charaja, Jhon P. F. and Ilg, Winfried and Haeufle, Daniel},
  booktitle       = {NeurIPS 2026 Workshop on Trustworthy AI for Good},
  year            = {2026},
  address         = {Paris, France},
  html            = {https://jo997.github.io/papers/failure-ranking/},
  website         = {https://openreview.net/forum?id=pet8zXl6WD},
  bibtex_show     = {true},
  selected        = {true},
  additional_info = {Shows that ranking prediction failures is not enough when the benefit of intervention differs from case to case. The paper introduces excess allocation value and threshold-corrected calibration value to select uncertainty scores and thresholds by the value of the cases they defer. Experiments span clinical referral, public-policy intervention, and activity recognition. Poster at the NeurIPS 2026 Trustworthy AI for Good workshop in Paris.}
}

@article{gaus2026confidence,
  abbr            = {ICRA Workshop},
  title           = {Confidence-Gated Robot Autonomy: When Does Uncertainty Actually Help?},
  author          = {Gaus, Johannes A. and Charaja, Jhon P. F. and Haeufle, Daniel},
  year            = {2026},
  arxiv           = {2605.18045},
  html            = {https://jo997.github.io/papers/confidence-gated-autonomy/},
  bibtex_show     = {true},
  preview         = {confidence-gate.png},
  selected        = {true},
  additional_info = {Benchmarks softmax scores, Monte Carlo dropout, and deep ensembles by the act or defer decisions they produce for wearable activity recognition. Once the base model is competent, estimator complexity matters less and the choice of gating threshold becomes the dominant factor.}
}

@article{gaus2026when,
  abbr            = {BioRob},
  title           = {When to Act: Calibrated Confidence for Reliable Human Intention Prediction in Assistive Robotics},
  author          = {Gaus, Johannes A. and Ilg, Winfried and Haeufle, Daniel},
  year            = {2026},
  arxiv           = {2601.04982},
  html            = {https://jo997.github.io/papers/when-to-act/},
  bibtex_show     = {true},
  preview         = {when-to-act.png},
  selected        = {true},
  additional_info = {Turns calibrated intention confidence into a verifiable ACT or HOLD safety rule for assistive devices. Post-hoc calibration shrinks the gap between reported confidence and true correctness by roughly an order of magnitude, so a single threshold can serve as an interpretable safety parameter. Submitted to IEEE RAS/EMBS BioRob.}
}

@inproceedings{gaus2026human,
  abbr            = {ICRA},
  title           = {Human-Interpretable Uncertainty Explanations for Point Cloud Registration},
  author          = {Gaus, Johannes A. and Schneider, Loris and Shi, Yitian and Lee, Jongseok and Rayyes, Rania and Triebel, Rudolph},
  booktitle       = {IEEE International Conference on Robotics and Automation (ICRA)},
  year            = {2026},
  address         = {Vienna, Austria},
  arxiv           = {2509.18786},
  html            = {https://jo997.github.io/papers/gpca/},
  bibtex_show     = {true},
  preview         = {gpca.png},
  selected        = {true},
  additional_info = {Introduces GP-CA, which scores registration uncertainty and attributes it to concrete, human-readable causes such as sensor noise, poor initialization, and limited overlap. Sample-efficient active learning discovers new failure sources with few queries, validated in simulation and on a real robot. Accepted at ICRA 2026, Vienna.}
}

@article{gaus2026super,
  abbr            = {Preprint},
  title           = {SUPER: A Framework for Sensitivity-Based Uncertainty-Aware Performance and Risk Assessment in Visual Inertial Odometry},
  author          = {Gaus, Johannes A. and Häufle, Daniel and Baek, Woo-Jeong},
  year            = {2026},
  arxiv           = {2512.14189},
  html            = {https://jo997.github.io/papers/super/},
  bibtex_show     = {true},
  preview         = {super.png},
  additional_info = {Derives a risk signal from the optimizer's sensitivity structure without requiring additional sensors or retraining. SUPER forecasts trajectory degradation and triggers recovery with less than 0.2 percent additional CPU cost. Currently under review.}
