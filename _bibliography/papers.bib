@article{gaus2026guard,
  abbr            = {IROS},
  title           = {GUARD: Toward a Compromise Between Traditional Control and Learning for Safe Robot Systems},
  author          = {Gaus, Johannes A. and Yoon, Junheon and Baek, Woo-Jeong and Choi, Seungwon and Park, Suhan and Park, Jaeheung},
  year            = {2026},
  arxiv           = {2509.23312},
  html            = {https://jo997.github.io/papers/guard/},
  bibtex_show     = {true},
  preview         = {guard.png},
  additional_info = {Pairs model-predictive control with uncertainty-aware perception for real-time collision avoidance. Learning estimates perception uncertainty, while an explicit controller keeps the safety-critical behavior open to inspection. Under submission at IROS 2026.}
}
